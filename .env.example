# Copy this file to .env (or set these as real environment variables /
# platform secrets when deploying) and fill in real values.

# Postgres connection string for persistent storage across deploys.
# Leave unset to use a local SQLite file (fine for local testing only —
# most free hosts wipe local files on every redeploy/restart).
# Example (Supabase): postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Direct-download URL for ser_model.pth (385MB — too big for git).
# Recommended: upload it to a Hugging Face Hub model repo, then use its
# "resolve" URL, e.g.:
# https://huggingface.co/<your-username>/<repo-name>/resolve/main/ser_model.pth
MODEL_URL=
